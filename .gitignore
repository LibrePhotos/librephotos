# Root-level .gitignore. Each app keeps its own .gitignore for app-specific rules.

# Dependencies (npm workspaces install into the root node_modules; the
# root package-lock.json is tracked for reproducible installs).
node_modules/
# npm ignores a lockfile inside a workspace; api-client.yml fails if one is committed.
packages/*/package-lock.json
apps/mobile/package-lock.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors / IDEs
.idea/
.vscode/
!.vscode/settings.json.example
*.swp
*.swo
*~

# Logs
*.log

# Env
.env
.env.local

# Local Python environments, coverage reports and test scratch dirs
.venv*/
htmlcov/
.testtmp-*/
# Cygwin/MSYS crash dumps
*.stackdump
