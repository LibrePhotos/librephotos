# Settings the backend reads from its environment. SECRET_KEY, ADMIN_PASSWORD, DB_USER and DB_PASS come from the
# "backend" and "database" secrets (see README.md). Most other variables are described on
# https://docs.librephotos.com/docs/installation/environment-variables
BACKEND_HOST=backend
ADMIN_EMAIL=somebody@example.com
ADMIN_USERNAME=admin
DB_BACKEND=postgresql
DB_NAME=librephotos
DB_HOST=postgres
DB_PORT=5432
WEB_CONCURRENCY=2
# Background workers for scanning, thumbnails and machine learning. Unset means one per CPU core of the node, not of
# the Pod, because a CPU limit does not change what the workers see. Set it to shrink the backend's CPU and RAM use.
# WORKER_CONCURRENCY=2
FEATURE_VIDEO=true
FEATURE_FACE_DETECTION=true
FEATURE_FACE_CLUSTER=true
FEATURE_IMAGE_CAPTIONING=true
FEATURE_REVERSE_GEOCODING=true
FEATURE_SCENE_CLASSIFICATION=true
FEATURE_PROCESS_EMBEDDED_MEDIA=true
# Uploads start out allowed here, while the Compose stack starts them off; uncomment to match it. This only picks the
# value the switch in Admin area -> Site Settings starts at. Once you save it there, the database value wins.
# ALLOW_UPLOAD=false
# The address in ingress.yaml, with its scheme. FRONTEND_BASE_URL builds the links in password-reset emails and the
# single sign-on redirect, which the backend cannot work out behind the proxy. CSRF_TRUSTED_ORIGINS lets the Django
# admin at /api/django-admin/ accept logins from it.
# FRONTEND_BASE_URL=https://photos.example.com
# CSRF_TRUSTED_ORIGINS=https://photos.example.com
# The proxy container runs as the Pod's user (runAsUser in backend.yaml), not as nginx's usual uid 101. The media
# diagnostics need the right ids to explain why a file could not be served.
WEBSERVER_UID=65534
WEBSERVER_GID=65534
# Log verbosity: CRITICAL, ERROR, WARNING, INFO or DEBUG. Default is INFO.
# LOG_LEVEL=INFO
# Where logs and secret.key are written; must match the logs volumeMount in backend.yaml. That volume is an emptyDir
# and is lost with the Pod. The log also goes to stdout (LOG_TO_CONSOLE, on by default), so a cluster log collector
# can keep it.
# BASE_LOGS=/logs
