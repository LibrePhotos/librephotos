[run]
branch = True
# The application code. A total over the whole tree would count the tests and
# the vendored chunked_upload app; the report reads the same source and omit.
source =
    api
    librephotos
    nextcloud
    service
    image_similarity
omit =
    */tests/*
    */tests.py
    */migrations/*
    */chunked_upload/*

[report]
# Measured on Windows, serial suite, rebased on dev cc80ac887: 91.159%, rounded
# down. Raise it when the total clears it by a whole point.
fail_under = 91
skip_covered = True
skip_empty = True
# show_missing = True

[html]
skip_covered = True
skip_empty = True
