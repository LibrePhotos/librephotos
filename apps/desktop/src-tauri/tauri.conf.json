{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LibrePhotos Viewer",
  "version": "0.1.0",
  "identifier": "com.librephotos.viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LibrePhotos Viewer",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 320,
        "theme": "Dark",
        "backgroundColor": "#1c1c1c",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../public/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt" },
    "category": "Photography",
    "copyright": "Copyright LibrePhotos contributors, MIT License",
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true
    },
    "fileAssociations": [
      {
        "ext": ["jpg", "jpeg", "jpe", "jfif", "png", "gif", "webp", "bmp", "tif", "tiff", "heic", "heif", "hif", "avif", "jxl"],
        "contentTypes": ["public.jpeg", "public.png", "com.compuserve.gif", "org.webmproject.webp", "com.microsoft.bmp", "public.tiff", "public.heic", "public.heif", "public.avif", "public.jpeg-xl"],
        "name": "LibrePhotosViewer.Image",
        "description": "Image",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["dng", "cr2", "cr3", "nef", "nrw", "arw", "orf", "rw2", "raf", "pef", "srw", "raw"],
        "contentTypes": ["public.camera-raw-image", "com.adobe.raw-image"],
        "name": "LibrePhotosViewer.Raw",
        "description": "Camera RAW image",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
