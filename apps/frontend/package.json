    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-filtered-fix": "0.3.0",
    "eslint-nibble": "9.1.1",
    "eslint-plugin-n": "^17.23.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jest": "29.7.0",
    "jsdom": "^25.0.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "typescript": "5.9.3"
  },
  "resolutions": {
    "react-i18next": "^15.7.4"
  }
}
