{
  "name": "librephotos-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:warn": "eslint --cache \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:error": "eslint --cache --quiet \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:error:fix": "eslint --quiet \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "lint:warning:fix": "eslint --cache --quiet \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "start": "vite",
    "build": "vite build",
    "test": "vitest --watch=false",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --watch=false",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "prepare": "husky install",
    "postinstall": "patch-package",
    "eslint-fix-interactive": "eslint-nibble --fixable-only \"./src/**/*.{js,jsx,ts,tsx}\"",
    "eslint-fix-specified": "eslint-filtered-fix \"./src/**/*.{js,jsx,ts,tsx}\" --rule import/no-duplicates"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "yarn prettier --config ./prettier.config.cjs --write",
      "yarn eslint --cache --quiet -c ./eslint.config.mjs"
    ],
    "*.{json,css,scss,md}": [
      "yarn prettier --config ./prettier.config.cjs  --write"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@mantine/carousel": "^9.0.0",
    "@mantine/charts": "^9.0.0",
    "@mantine/core": "^9.0.0",
    "@mantine/dates": "^9.0.0",
    "@mantine/form": "^9.0.0",
    "@mantine/hooks": "^9.0.0",
    "@mantine/notifications": "^9.0.0",
    "@mantine/spotlight": "^9.0.0",
    "@mantine/tiptap": "^9.0.0",
    "@tabler/icons": "^3.41.1",
    "@tabler/icons-react": "^3.41.1",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-router": "^1.168.10",
    "@tanstack/router-plugin": "^1.167.12",
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-document": "^3.0.0",
    "@tiptap/extension-link": "^3.0.0",
    "@tiptap/extension-mention": "^3.0.0",
    "@tiptap/extension-paragraph": "^3.0.0",
    "@tiptap/extension-text": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/suggestion": "^3.0.0",
    "@use-gesture/react": "^10.3.1",
    "@visx/gradient": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/hierarchy": "4.0.0",
    "@visx/shape": "4.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@welldone-software/why-did-you-render": "^10.0.0",
    "clsx": "^2.1.1",
    "crypto-js": "4.2.0",
    "d3": "7.9.0",
    "d3-hierarchy": "3.1.2",
    "d3-shape": "3.2.0",
    "dayjs": "^1.11.20",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^26.0.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "luxon": "3.7.2",
    "maplibre-gl": "^6.0.0",
    "motion": "^13.0.0",
    "patch-package": "8.0.1",
    "prop-types": "15.8.1",
    "react": "19.2.8",
    "react-avatar-editor": "15.1.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-cookie": "^8.0.0",
    "react-cool-dimensions": "3.0.1",
    "react-dnd": "16.0.1",
    "react-dom": "19.2.8",
    "react-dropzone": "^20.0.0",
    "react-i18next": "^17.0.0",
    "react-map-gl": "^8.0.0",
    "react-virtualized": "9.22.6",
    "recharts": "^3.0.0",
    "tippy.js": "^6.3.7",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "zod": "4.4.3"
