{
  "name": "librephotos-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:error": "eslint --cache --max-warnings 0 .",
    "lint:error:fix": "eslint --max-warnings 0 . --fix",
    "format": "prettier --config ./prettier.config.cjs --write . ../../packages/api-client",
    "format:check": "prettier --config ./prettier.config.cjs --check . ../../packages/api-client",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "knip": "knip",
    "start": "vite",
    "build": "vite build",
    "test": "vitest --watch=false",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --watch=false",
    "prepare": "husky",
    "eslint-fix-interactive": "eslint-nibble --fixable-only \"./src/**/*.{js,jsx,ts,tsx}\""
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "yarn prettier --config ./prettier.config.cjs --write",
      "yarn eslint --cache --max-warnings 0 -c ./eslint.config.mjs"
    ],
    "*.{json,css,scss,md}": [
      "yarn prettier --config ./prettier.config.cjs  --write"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/dom": "^1.8.0",
    "@mantine/carousel": "^9.7.1",
    "@mantine/charts": "^9.7.1",
    "@mantine/core": "^9.7.1",
    "@mantine/dates": "^9.7.1",
    "@mantine/form": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@mantine/notifications": "^9.7.1",
    "@mantine/spotlight": "^9.7.1",
    "@mantine/tiptap": "^9.7.1",
    "@tabler/icons-react": "^3.41.1",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-router": "^1.168.10",
    "@tanstack/react-virtual": "^3.14.13",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-document": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-mention": "^3.31.4",
    "@tiptap/extension-paragraph": "^3.31.4",
    "@tiptap/extension-text": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "@use-gesture/react": "^10.3.1",
    "@visx/gradient": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/hierarchy": "4.0.0",
    "@visx/shape": "4.0.0",
    "@welldone-software/why-did-you-render": "^10.0.1",
    "clsx": "^2.1.1",
    "crypto-js": "4.2.0",
    "d3-drag": "3.0.0",
    "d3-force": "3.0.0",
    "d3-hierarchy": "3.1.2",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "d3-zoom": "3.0.0",
    "dayjs": "^1.11.20",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^26.0.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "jwt-decode": "^4.0.0",
    "lodash-es": "^4.18.1",
    "luxon": "3.7.2",
    "maplibre-gl": "^6.0.0",
    "motion": "^14.0.0",
    "react": "19.3.1",
    "react-avatar-editor": "16.0.0",
    "react-cookie": "^8.0.0",
    "react-cool-dimensions": "3.0.1",
    "react-dom": "19.3.1",
    "react-dropzone": "^20.0.0",
    "react-i18next": "^17.0.0",
    "react-is": "19.3.1",
    "react-map-gl": "^8.1.3",
    "recharts": "^3.10.1",
    "tippy.js": "^6.3.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tanstack/eslint-plugin-query": "5.104.5",
    "@tanstack/router-plugin": "^1.167.12",
    "@types/crypto-js": "4.2.2",
    "@types/d3-drag": "3.0.7",
