    "@visx/hierarchy": "3.12.0",
    "@visx/shape": "3.12.0",
    "@vitejs/plugin-react": "^5.1.3",
    "@welldone-software/why-did-you-render": "^8.0.3",
    "clsx": "^2.1.1",
    "crypto-js": "4.2.0",
    "d3": "7.9.0",
    "d3-hierarchy": "3.1.2",
