{
  "name": "@librephotos/api-client",
  "version": "0.1.0",
  "description": "Platform-agnostic LibrePhotos API client: zod schemas, injectable fetch transport, and TanStack Query v5 hooks. Shared between apps/frontend and apps/mobile.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./transport": "./src/transport/index.ts",
    "./hooks": "./src/hooks/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.96.0",
    "react": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tanstack/eslint-plugin-query": "5.104.1",
    "@tanstack/react-query": "^5.101.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "react": "19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^5.0.0",
    "zod": "^4.6.6"
  }
}
