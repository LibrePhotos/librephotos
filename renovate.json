{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Never bump PyExifTool. Pinned to 0.4.9; 0.5.x breaks metadata extraction.",
      "matchPackageNames": ["PyExifTool", "pyexiftool"],
      "enabled": false
    },
    {
      "description": "Never auto-bump scikit-learn. The backend-gpu image runs Python 3.10, where scikit-learn 1.8.0+ are unavailable, so requirements.txt carries a python_version split (1.9.0 on >=3.11, 1.7.2 on <3.11). Renovate bumps every matching line to one version and collapses the split, breaking the GPU build. Bump manually and keep the <3.11 pin at <=1.7.2.",
      "matchPackageNames": ["scikit-learn", "scikit_learn"],
      "enabled": false
    },
    {
      "matchFileNames": ["apps/backend/**"],
      "groupName": "backend dependencies",
      "addLabels": ["backend"]
    },
    {
      "matchFileNames": ["apps/frontend/**"],
      "groupName": "frontend dependencies",
      "addLabels": ["frontend"]
    },
    {
      "matchFileNames": ["apps/mobile/**"],
      "groupName": "mobile dependencies",
      "addLabels": ["mobile"]
    },
    {
      "matchFileNames": ["apps/docs/**"],
      "groupName": "docs dependencies",
      "addLabels": ["docs"]
    },
    {
      "matchFileNames": ["deploy/**"],
      "groupName": "deploy dependencies",
      "addLabels": ["deploy"]
    },
    {
      "matchFileNames": [".github/workflows/**"],
      "groupName": "github-actions",
      "addLabels": ["ci"]
    }
  ]
}
