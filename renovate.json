{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Never bump PyExifTool. Pinned to 0.4.9; 0.5.x breaks metadata extraction.",
      "matchPackageNames": ["PyExifTool", "pyexiftool"],
      "enabled": false
    },
    {
      "matchFileNames": ["apps/backend/**"],
      "groupName": "backend dependencies",
      "addLabels": ["backend"]
    },
    {
      "matchFileNames": ["apps/frontend/**"],
      "groupName": "frontend dependencies",
      "addLabels": ["frontend"]
    },
    {
      "matchFileNames": ["apps/mobile/**"],
      "groupName": "mobile dependencies",
      "addLabels": ["mobile"]
    },
    {
      "matchFileNames": ["apps/docs/**"],
      "groupName": "docs dependencies",
      "addLabels": ["docs"]
    },
    {
      "matchFileNames": ["deploy/**"],
      "groupName": "deploy dependencies",
      "addLabels": ["deploy"]
    },
    {
      "matchFileNames": [".github/workflows/**"],
      "groupName": "github-actions",
      "addLabels": ["ci"]
    }
  ]
}
